{
  "name": "Classic",
  "description": "Timeless and calm: Optima, pine-green headings, italic subheads, 1-inch margins.",
  "docx": {
    "paper": "letter",
    "margin": 1,
    "bodyFont": "Optima",
    "headingFont": "Optima",
    "monoFont": "Menlo",
    "fontSize": 11,
    "lineSpacing": 1.3,
    "spaceAfter": 9,
    "firstLineIndent": 0,
    "justify": false,
    "textColor": "1C1C1C",
    "headingColor": "2E5E4E",
    "headingSizes": [18, 14, 11],
    "headingBold": false,
    "numberedHeadings": false,
    "titleSize": 26,
    "titleColor": "1C1C1C",
    "titleAlign": "left",
    "titleRule": true,
    "captionSize": 9.5,
    "captionColor": "555555",
    "captionItalic": true,
    "accentColor": "2E5E4E",
    "tableHeaderFill": "",
    "pageNumbers": true
  }
}
